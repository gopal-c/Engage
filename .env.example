# Neon Postgres
POSTGRES_URL=postgres://user:pass@host/dbname?sslmode=require
POSTGRES_URL_NON_POOLING=postgres://user:pass@host/dbname?sslmode=require

# NextAuth
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# App URL (used for illustration URLs in emails, PWA)
NEXT_PUBLIC_APP_URL=https://engage-portal.vercel.app

# BirthdayHub — AI message generation
GROQ_API_KEY=gsk_...

# BirthdayHub — Email sending (Gmail SMTP)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password
GMAIL_FROM_NAME=The HR Team

# BirthdayHub — Cron protection
CRON_SECRET=your-cron-secret

# BirthdayHub — GitHub Actions cron schedule sync (optional)
GITHUB_TOKEN=ghp_...
GITHUB_REPO=gopal-c/Engage
